# =============================================================================
# Variables de Entorno — Web App Inventario Papelería
# =============================================================================

# 1. Configuración de PostgreSQL Local (Docker / Entorno de Desarrollo Canónico)
# Contenedor estándar del proyecto: pg_integration_test (PostgreSQL 15 en puerto 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inventario_dev
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=your_local_postgres_password
PGDATABASE=inventario_dev
SESSION_SECRET=your_local_session_secret_change_in_production

# 2. Configuración de Supabase Cloud (Producción / Integración Remota)
# Reemplazar con las credenciales de tu proyecto en Supabase Cloud (https://supabase.com/dashboard)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# 3. Credenciales de Prueba (tests/cloud/supabase_cloud.test.ts y tests E2E)
TEST_ADMIN_EMAIL=admin@papeleria.local
TEST_ADMIN_PASSWORD=your_admin_secure_password
TEST_CAJERO_EMAIL=cajero@papeleria.local
TEST_CAJERO_PASSWORD=your_cajero_secure_password

